using Random

# You would define the "True Physics" of the world somewhere globally
const TRUE_MU = 0.05    # 5% annual expected return
const TRUE_SIGMA = 0.20 # 20% annual volatility

function see_some_data(S_prev, dt)
    # dt is the time step size as a fraction of a year (e.g., 1/365 for daily)
    
    Z = randn() # Draw from standard normal N(0,1)
    
    # Calculate the GBM multiplier
    drift_term = (TRUE_MU - (TRUE_SIGMA^2) / 2.0) * dt
    shock_term = TRUE_SIGMA * sqrt(dt) * Z
    
    S_now = S_prev * exp(drift_term + shock_term)
    
    return S_now
end
```

