                u = rand(Normal(mu_u, sigma_u))
                spot_i *= (1 + u)
            else
                d = rand(Normal(mu_d, sigma_d))
                spot_i *= (1 - d)
            end
        end
        spot_ends[i] = spot_i       # store each path's final price in the pre-allocated vector
    end
