    d1 = (log(spot_now / K) + (r + true_sigma^2 / 2.0) * t) / (true_sigma * sqrt(t))
    standard_normal = Normal(0.0, 1.0)
    bs_delta = cdf(standard_normal, d1)
    return bs_delta
end

